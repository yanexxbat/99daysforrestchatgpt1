-- Toggle factory
local function createToggle(label, default, onChange)
    local c = Instance.new("Frame")
    c.Size = UDim2.new(1, -4, 0, 34)
    c.BackgroundColor3 = COLORS.bgMid
    c.Parent = sectionScroll
    do local cc=Instance.new("UICorner",c); cc.CornerRadius = UDim.new(0,8) end

    local l = Instance.new("TextLabel")
    l.Size = UDim2.new(1, -110, 1, 0)
    l.Position = UDim2.new(0, 10, 0, 0)
    l.BackgroundTransparency = 1
    l.Text = label
    l.TextColor3 = COLORS.text
    l.TextScaled = true
    l.Font = Enum.Font.Gotham
    l.Parent = c

    local b = Instance.new("TextButton")
    b.Size = UDim2.new(0, 90, 0, 28)
    b.Position = UDim2.new(1, -100, 0, 3)
    b.BackgroundColor3 = default and COLORS.ok or COLORS.off
    b.Text = default and "ON" or "OFF"
    b.TextColor3 = COLORS.text
    b.TextScaled = true
    b.Font = Enum.Font.GothamBold
    b.Parent = c
    do local bc=Instance.new("UICorner",b); bc.CornerRadius = UDim.new(0,8) end

    local state = default
    b.MouseButton1Click:Connect(function()
        state = not state
        b.BackgroundColor3 = state and COLORS.ok or COLORS.off
        b.Text = state and "ON" or "OFF"
        onChange(state)
    end)

    return c
end

