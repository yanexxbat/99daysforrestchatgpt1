-- Cleanup function
local function cleanup()
    destroyed = true
    
    print("Starting cleanup...")
    
    -- Disconnect all connections safely
    for i, conn in pairs(connections) do
        safeDisconnect(conn)
        connections[i] = nil
    end
    
    -- Disconnect feature connections
    safeDisconnect(jumpConnection)
    safeDisconnect(noclipConnection)
    safeDisconnect(flyConnection)
    
    if antiAFKConnection then 
        pcall(function() task.cancel(antiAFKConnection) end)
        antiAFKConnection = nil
    end
    
    if bodyVelocity then 
        pcall(function() bodyVelocity:Destroy() end)
        bodyVelocity = nil
    end
    
    -- Clean up ESP
    for obj, data in pairs(objectData) do
        removeESP(obj)
    end
    objectData = {}
    
    print("Noctis Utility V2 - Cleaned up")
end

