end)

-- Event connections with safe handling
local function connectWorkspaceEvents()
    local success1, conn1 = pcall(function()
        return Workspace.DescendantAdded:Connect(function(obj) 
            task.defer(registerObject, obj) 
        end)
    end)
    if success1 then table.insert(connections, conn1) end

    local success2, conn2 = pcall(function()
        return Workspace.DescendantRemoving:Connect(unregisterObject)
    end)
    if success2 then table.insert(connections, conn2) end
end

connectWorkspaceEvents()

-- ESP Update Loop
local lastESPUpdate = 0
local espUpdateConnection = RunService.Heartbeat:Connect(function()
    if destroyed then return end
    
    local now = tick()
    if now - lastESPUpdate < 0.1 then return end
    lastESPUpdate = now
    
    pcall(function()
        local char = localPlayer.Character
        local root = char and char:FindFirstChild("HumanoidRootPart")
        
        for obj, data in pairs(objectData) do
            if not obj or not obj.Parent then
                task.defer(unregisterObject, obj)
                continue
            end
            
            local cat = data.category
            local shouldShow = CONFIG.ENABLED and (
                (cat == "CHEST" and CONFIG.SHOW_CHESTS) or
                (cat == "ITEM" and CONFIG.SHOW_ITEMS) or
                (cat == "RESOURCE" and CONFIG.SHOW_RESOURCES) or
                (cat == "PLAYER" and CONFIG.SHOW_PLAYERS) or
                (cat == "NPC" and CONFIG.SHOW_NPCS) or
                (cat == "MOB" and CONFIG.SHOW_MOBS) or
                (cat == "CAMP" and CONFIG.SHOW_CAMPS)
            )
            
            local shouldShowName = shouldShow and (
                (cat == "CHEST" and CONFIG.SHOW_CHEST_NAMES) or
                (cat == "ITEM" and CONFIG.SHOW_ITEM_NAMES) or
                (cat == "RESOURCE" and CONFIG.SHOW_RESOURCE_NAMES) or
                (cat == "PLAYER" and CONFIG.SHOW_PLAYER_NAMES) or
                (cat == "NPC" and CONFIG.SHOW_NPC_NAMES) or
                (cat == "MOB" and CONFIG.SHOW_MOB_NAMES) or
                (cat == "CAMP" and CONFIG.SHOW_CAMP_NAMES)
            )
            
            if data.billboard then
                data.billboard.Enabled = shouldShow
                if data.label then
                    data.label.Visible = shouldShowName
                    if shouldShow then 
                        data.label.TextColor3 = colorFor(obj.Name, cat) 
                    end
                end
                
                if data.distLabel and root and data.mainPart then
                    local distance = (root.Position - data.mainPart.Position).Magnitude
                    data.distLabel.Text = string.format("%.0fm", distance)
                end
            end
        end
    end)
end)

