-- === UNINJECT FUNCTION ===
local function uninject()
    for _, d in pairs(objectData) do
        if d.billboard then d.billboard:Destroy() end
        if d.highlight then d.highlight:Destroy() end
    end
    objectData = {}

    for _, c in ipairs(connections) do
        if typeof(c) == "RBXScriptConnection" then
            c:Disconnect()
        end
    end
    connections = {}

    if screenGui then
        screenGui:Destroy()
    end

    print("❌ ESP Detector uninjected successfully!")
end

print("✅ ESP Detector loaded (Better Chest Detection, Flowers/Sticks = Resource)!")
