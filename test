-- Checkbox Factory
local function createCheckbox(labelText, defaultValue, onChange)
    local container = Instance.new("Frame")
    container.Size = UDim2.new(0, 150, 0, 28)
    container.BackgroundTransparency = 1
    container.Parent = contentFrame

    local checkbox = Instance.new("TextButton")
    checkbox.Size = UDim2.fromOffset(CONSTANTS.CHECKBOX_SIZE, CONSTANTS.CHECKBOX_SIZE)
    checkbox.Position = UDim2.new(0, 0, 0, 4)
    checkbox.BackgroundColor3 = defaultValue and COLORS.success or COLORS.bgLight
    checkbox.Text = defaultValue and "✓" or ""
    checkbox.TextColor3 = COLORS.text
    checkbox.TextScaled = true
    checkbox.Font = Enum.Font.GothamBold
    checkbox.Parent = container
    Instance.new("UICorner", checkbox).CornerRadius = UDim.new(0, 4)

    local label = Instance.new("TextLabel")
    label.Size = UDim2.new(1, -30, 1, 0)
    label.Position = UDim2.new(0, 30, 0, 0)
    label.BackgroundTransparency = 1
    label.Text = labelText
    label.TextColor3 = COLORS.text
    label.TextScaled = true
    label.Font = Enum.Font.Gotham
    label.TextXAlignment = Enum.TextXAlignment.Left
    label.Parent = container

    local state = defaultValue
    checkbox.MouseButton1Click:Connect(function()
        state = not state
        checkbox.BackgroundColor3 = state and COLORS.success or COLORS.bgLight
        checkbox.Text = state and "✓" or ""
        
        local success = pcall(onChange, state)
        if not success then
            warn("Checkbox callback failed for '" .. labelText .. "'")
        end
    end)

    return container
end

