-- Auto Wood Farm
--=============================
local function startWoodFarm()
    if autoFarmThread then task.cancel(autoFarmThread) end
    autoFarmThread = task.spawn(function()
        while CONFIG.AUTO_WOOD_FARM and not destroyed do
            local char = localPlayer.Character
            local root = char and char:FindFirstChild("HumanoidRootPart")
            if root then
                -- 1) Nächsten Baum finden
                local nearestTree, ndist
                for obj, dat in pairs(objectData) do
                    if nameMatches(obj, NAME_KEYWORDS.TREE) then
                        local mp = getMainPart(obj)
                        if mp then
                            local d = (mp.Position - root.Position).Magnitude
                            if not ndist or d < ndist then nearestTree, ndist = mp, d end
                        end
                    end
                end

                if nearestTree then
                    teleportTo(nearestTree.Position + Vector3.new(0, CONFIG.FARM_OFFSET_Y, 0))
                    task.wait(0.6)

                    -- 2) Axt benutzen (falls vorhanden)
                    local tool = char:FindFirstChildWhichIsA("Tool") or localPlayer.Backpack:FindFirstChildWhichIsA("Tool")
                    if tool and lower(tool.Name):find("axe") then
                        for i=1,6 do
                            pcall(function() tool.Parent = char; tool:Activate() end)
                            task.wait(0.25)
                        end
                    else
                        -- Kein Tool → trotzdem versuchen, Prompts am Baum auszulösen
                        local parent = nearestTree.Parent
                        if parent then
                            for _, ins in ipairs(parent:GetDescendants()) do
                                if ins:IsA("ProximityPrompt") then
                                    pcall(function() ins:InputHoldBegin(); task.wait(0.3); ins:InputHoldEnd() end)
                                end
                            end
                        end
                    end
                end

                -- 3) Holz einsammeln (in der Nähe)
                for obj, dat in pairs(objectData) do
                    if nameMatches(obj, NAME_KEYWORDS.WOOD) then
                        local mp = getMainPart(obj)
                        if mp and (mp.Position - root.Position).Magnitude < 35 then
                            teleportTo(mp.Position + Vector3.new(0, 2, 0))
                            task.wait(0.2)
                            for _, ins in ipairs(obj:GetDescendants()) do
                                if ins:IsA("ProximityPrompt") then
                                    pcall(function() ins:InputHoldBegin(); task.wait(0.25); ins:InputHoldEnd() end)
                                elseif ins:IsA("ClickDetector") then
                                    pcall(function() fireclickdetector(ins) end)
                                end
                            end
                        end
                    end
                end

                -- 4) Zum Camp laufen und abgeben
                for _, obj in ipairs(Workspace:GetChildren()) do
                    if nameMatches(obj, NAME_KEYWORDS.CAMP) then
                        local mp = getMainPart(obj)
                        if mp then
                            teleportTo(mp.Position + Vector3.new(0, 5, 0))
                            task.wait(0.4)
                            for _, ins in ipairs(obj:GetDescendants()) do
                                if ins:IsA("ProximityPrompt") then
                                    pcall(function() ins:InputHoldBegin(); task.wait(0.25); ins:InputHoldEnd() end)
                                end
                            end
                        end
                    end
                end
            end
            task.wait(CONFIG.FARM_INTERVAL)
        end
    end)
end

