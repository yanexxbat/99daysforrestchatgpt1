--=============================
-- Uninject
--=============================

local function uninject()
    destroyed = true

    for _, c in ipairs(connections) do
        if typeof(c) == "RBXScriptConnection" then
            pcall(function() c:Disconnect() end)
        end
    end
    connections = {}

    for obj, d in pairs(objectData) do
        pcall(function()
            if d.billboard then d.billboard:Destroy() end
        end)
    end
    objectData = {}
    chestIdByObject = setmetatable({}, {__mode="k"})
    campIdByObject  = setmetatable({}, {__mode="k"})
    chestCounter, campCounter = 0, 0

    if screenGui then pcall(function() screenGui:Destroy() end) end
    print("Uninject complete.")
end
