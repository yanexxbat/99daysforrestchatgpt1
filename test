-- Auto Wood Farm Toggle
autoFarmToggleBtn = createToggle("Auto Wood Farm", CONFIG.AUTO_WOOD_FARM, function(v)
    CONFIG.AUTO_WOOD_FARM = v
    if v then
        -- (re)start farm loop
        if autoFarmThread then task.cancel(autoFarmThread) end
        autoFarmThread = task.spawn(function()
            while CONFIG.AUTO_WOOD_FARM and not destroyed do
                -- finde nächste Resource mit "wood/log/tree/stick/branch"
                local char = localPlayer.Character
                local root = char and char:FindFirstChild("HumanoidRootPart")
                if root then
                    local nearest, ndist
                    for obj, dat in pairs(objectData) do
                        if dat.category == "RESOURCE" then
                            local mp = getMainPart(obj)
                            if mp then
                                local d = (mp.Position - root.Position).Magnitude
                                if not ndist or d < ndist then
                                    nearest, ndist = mp, d
                                end
                            end
                        end
                    end
                    if nearest then
                        local target = nearest.Position + Vector3.new(0, CONFIG.FARM_OFFSET_Y, 0)
                        local tween = TweenService:Create(root, TweenInfo.new(0.6, Enum.EasingStyle.Quad), {CFrame = CFrame.new(target)})
                        tween:Play()
                        tween.Completed:Wait()

                        -- Versuche Interaktion: ProximityPrompt/ClickDetector
                        local parent = nearest.Parent
                        if parent then
                            for _, ins in ipairs(parent:GetDescendants()) do
                                if ins:IsA("ProximityPrompt") then
                                    pcall(function()
                                        ins:InputHoldBegin()
                                        task.wait(0.2)
                                        ins:InputHoldEnd()
                                    end)
                                elseif ins:IsA("ClickDetector") then
                                    pcall(function() fireclickdetector(ins) end)
                                end
                            end
                        end
                    end
                end
                task.wait(CONFIG.FARM_INTERVAL)
            end
        end)
    else
        if autoFarmThread then task.cancel(autoFarmThread) end
        autoFarmThread = nil
    end
end)
