table.insert(connections, Workspace.DescendantAdded:Connect(function(o) task.defer(registerObject, o) end))
table.insert(connections, Workspace.DescendantRemoving:Connect(unregisterObject))

-- Update loop
local function updateESP()
    if destroyed then return end
    for obj, data in pairs(objectData) do
        if CONFIG.ENABLED and obj and obj.Parent then
            local active =
                (data.category == "CHEST"    and CONFIG.SHOW_CHESTS) or
                (data.category == "ITEM"     and CONFIG.SHOW_ITEMS) or
                (data.category == "RESOURCE" and CONFIG.SHOW_RESOURCES) or
                (data.category == "PLAYER"   and CONFIG.SHOW_PLAYERS) or
                (data.category == "NPC"      and CONFIG.SHOW_NPCS) or
                (data.category == "MOB"      and CONFIG.SHOW_MOBS)
            data.billboard.Enabled = active
            data.label.TextColor3 = colorFor(obj.Name, data.category)
        else
            data.billboard.Enabled = false
        end
    end
end

table.insert(connections, RunService.RenderStepped:Connect(updateESP))

-- Teleport Utility (MoveTo bevorzugt, Fallback Tween)
local function teleportTo(pos)
    local char = localPlayer.Character
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    local root = char and char:FindFirstChild("HumanoidRootPart")
    if not root or not hum then return end

    pcall(function() hum:MoveTo(pos) end)
    task.delay(0.8, function()
        if not root or destroyed then return end
        if (root.Position - pos).Magnitude > 6 then
            TweenService:Create(root, TweenInfo.new(0.8, Enum.EasingStyle.Quad), {CFrame = CFrame.new(pos)}):Play()
        end
    end)
end

