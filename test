local function setupInvisible()
    pcall(function()
        local char = localPlayer.Character
        if char then
            for _, part in pairs(char:GetDescendants()) do
                if part:IsA("BasePart") then
                    part.Transparency = CONFIG.INVISIBLE and 1 or 0
                elseif part:IsA("Decal") or part:IsA("Texture") then
                    part.Transparency = CONFIG.INVISIBLE and 1 or 0
                elseif part:IsA("Accessory") then
                    local handle = part:FindFirstChild("Handle")
                    if handle then handle.Transparency = CONFIG.INVISIBLE and 1 or 0 end
                end
            end
            local head = char:FindFirstChild("Head")
            if head then
                local face = head:FindFirstChild("face")
                if face then face.Transparency = CONFIG.INVISIBLE and 1 or 0 end
            end
            print("Invisible:", CONFIG.INVISIBLE)
        end
    end)
end

local function setupAntiAFK()
    if antiAFKConnection then 
        pcall(function() task.cancel(antiAFKConnection) end)
    end
    antiAFKConnection = nil
    
    if CONFIG.ANTI_AFK then
        antiAFKConnection = task.spawn(function()
            while CONFIG.ANTI_AFK do
                task.wait(30)
                pcall(function()
                    local char = localPlayer.Character
                    if char then
                        local humanoid = char:FindFirstChildOfClass("Humanoid")
                        if humanoid then
                            humanoid:Move(Vector3.new(0.1, 0, 0))
                            task.wait(0.1)
                            humanoid:Move(Vector3.new(-0.1, 0, 0))
                        end
                    end
                end)
            end
        end)
        print("Anti-AFK enabled")
    else
        print("Anti-AFK disabled")
    end
end

