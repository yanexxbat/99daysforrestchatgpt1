-- VERBESSERTE Toggle Factory
local function createToggle(labelText, defaultValue, onChange, description)
    local container = Instance.new("Frame")
    container.Size = UDim2.new(1, -8, 0, description and 50 or 38)
    container.BackgroundColor3 = COLORS.bgMid
    container.Parent = sectionScroll
    local corner = Instance.new("UICorner", container)
    corner.CornerRadius = UDim.new(0, 8)

    local label = Instance.new("TextLabel")
    label.Size = UDim2.new(1, -120, description and 0.6 or 1, 0)
    label.Position = UDim2.new(0, 12, 0, 0)
    label.BackgroundTransparency = 1
    label.Text = labelText
    label.TextColor3 = COLORS.text
    label.TextScaled = true
    label.Font = Enum.Font.GothamMedium
    label.TextXAlignment = Enum.TextXAlignment.Left
    label.Parent = container
    
    if description then
        local desc = Instance.new("TextLabel")
        desc.Size = UDim2.new(1, -120, 0.4, 0)
        desc.Position = UDim2.new(0, 12, 0.6, 0)
        desc.BackgroundTransparency = 1
        desc.Text = description
        desc.TextColor3 = Color3.fromRGB(150, 150, 150)
        desc.TextScaled = true
        desc.Font = Enum.Font.Gotham
        desc.TextXAlignment = Enum.TextXAlignment.Left
        desc.Parent = container
    end

    local button = Instance.new("TextButton")
    button.Size = UDim2.new(0, 100, 0, 28)
    button.Position = UDim2.new(1, -110, 0, 5)
    button.BackgroundColor3 = defaultValue and COLORS.ok or COLORS.off
    button.Text = defaultValue and "ENABLED" or "DISABLED"
    button.TextColor3 = COLORS.text
    button.TextScaled = true
    button.Font = Enum.Font.GothamBold
    button.Parent = container
    local corner5 = Instance.new("UICorner", button)
    corner5.CornerRadius = UDim.new(0, 8)

    local state = defaultValue
    button.MouseButton1Click:Connect(function()
        state = not state
        button.BackgroundColor3 = state and COLORS.ok or COLORS.off
        button.Text = state and "ENABLED" or "DISABLED"
        
        local success, err = pcall(onChange, state)
        if not success then
            warn("Toggle callback failed for '" .. labelText .. "': " .. tostring(err))
        end
    end)

    return container
end

