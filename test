-- === ESP Detector Script (Better Detection, No Duplicate Chests) ===
-- Chests -> "Chest 1, Chest 2..."
-- Flowers, Sticks, Branches -> treated as Resource
-- Full GUI + Chest Teleport + Uninject

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")
local TweenService = game:GetService("TweenService")

local player = Players.LocalPlayer
local playerGui = player:WaitForChild("PlayerGui")

local CAMP_POSITION = Vector3.new(0,5,0)

local CONFIG = {
    ENABLED = true,
    SHOW_CHESTS = true,
    SHOW_ITEMS = true,
    SHOW_RESOURCES = true,
    SHOW_PLAYERS = true,
    SHOW_NPCS = true,
    SHOW_MOBS = true,
    MAX_DISPLAY_DISTANCE = 500,
}

-- === STORAGE ===
local objectData = {}
local chestCounter = 0
local connections = {}
local screenGui
local tpFrame
local tpList

-- === TARGETS ===
local TARGETS = {
    CHEST = {"chest","crate","box","container","loot"},
    ITEM = {"axe","sword","bow","key","potion","food","bread","meat","bandage"},
    RESOURCE = {"wood","stone","ore","coal"},
    NPC = {"alien","cultist","npc","villager","soldier","guard"},
    MOB = {"wolf","bear","rat","spider","skeleton","zombie","mob"}
}

-- === COLORS ===
local function getItemColor(name, category)
    local n = name:lower()
    if category == "CHEST" then return Color3.new(1,0.85,0) end
    if category == "RESOURCE" then return Color3.new(0.6,0.7,1) end
    if category == "NPC" then return Color3.new(0.2,1,0.2) end
    if category == "MOB" then return Color3.new(1,0,0) end
    if category == "PLAYER" then return Color3.new(0,1,1) end
    if n:find("sword") then return Color3.new(1,0.3,0.3) end
    if n:find("bow") then return Color3.new(1,0.6,0.2) end
    if n:find("axe") then return Color3.new(0.3,1,0.3) end
    if n:find("potion") or n:find("food") or n:find("meat") or n:find("bread") then
        return Color3.new(1,0.4,0.8)
    end
    return Color3.new(1,1,1)
end

-- === CATEGORY DETECTION ===
local function getCategory(obj)
    local n = obj.Name:lower()

    -- 🌸 Flowers / Sticks / Branches => Resource
    if n:find("flower") or n:find("blume") or n:find("stick") or n:find("ast") or n:find("branch") then
        return "RESOURCE"
    end

    -- 📦 Chest detection (only top-level models or unique parts)
    if (obj:IsA("Model") or obj:IsA("Folder")) and (n:find("chest") or n:find("crate") or n:find("loot")) then
        return "CHEST"
    elseif obj:IsA("BasePart") and n:find("chest") then
        if not objectData[obj.Parent] then
            return "CHEST"
        else
            return nil
        end
    end

    -- 🎒 Items
    for _, v in ipairs(TARGETS.ITEM) do if n:find(v) then return "ITEM" end end

    -- ⛏ Resources
    for _, v in ipairs(TARGETS.RESOURCE) do if n:find(v) then return "RESOURCE" end end

    -- 👤 NPCs
    for _, v in ipairs(TARGETS.NPC) do if n:find(v) then return "NPC" end end

    -- 🐺 Mobs
    for _, v in ipairs(TARGETS.MOB) do if n:find(v) then return "MOB" end end

    -- 👥 Players
    if Players:GetPlayerFromCharacter(obj) then return "PLAYER" end

    return nil
end

-- === MAIN PART DETECTION ===
local function getMainPart(obj)
    if obj:IsA("Model") then
        if obj.PrimaryPart then return obj.PrimaryPart end
        if obj:FindFirstChild("HumanoidRootPart") then return obj.HumanoidRootPart end
        if obj:FindFirstChild("Handle") then return obj.Handle end
        for _, part in ipairs(obj:GetChildren()) do
            if part:IsA("BasePart") then return part end
        end
    elseif obj:IsA("BasePart") then
        return obj
    end
    return nil
end

-- === ESP CREATION ===
local function createESP(obj, category)
    local mainPart = getMainPart(obj)
    if not mainPart then return end

    local billboard = Instance.new("BillboardGui")
    billboard.Size = UDim2.new(0,160,0,40)
    billboard.StudsOffset = Vector3.new(0,3,0)
    billboard.AlwaysOnTop = true
    billboard.MaxDistance = CONFIG.MAX_DISPLAY_DISTANCE
    billboard.Adornee = mainPart
    billboard.Parent = mainPart

    local text = Instance.new("TextLabel")
    text.Size = UDim2.new(1,0,1,0)
    text.BackgroundTransparency = 1
    text.TextScaled = true
    text.Font = Enum.Font.GothamBold
    text.TextStrokeTransparency = 0
    text.TextStrokeColor3 = Color3.new(0,0,0)
    text.TextColor3 = getItemColor(obj.Name, category)
    text.Parent = billboard

    if category == "CHEST" then
        chestCounter += 1
        text.Text = "Chest " .. chestCounter
    elseif category == "PLAYER" then
        local plr = Players:GetPlayerFromCharacter(obj)
        text.Text = plr and plr.Name or "Player"
    else
        text.Text = obj.Name
    end

    local highlight = Instance.new("Highlight")
    highlight.FillTransparency = 1
    highlight.OutlineTransparency = 0
    highlight.OutlineColor = getItemColor(obj.Name, category)
    highlight.Adornee = mainPart
    highlight.Parent = mainPart

    objectData[obj] = {billboard = billboard, text = text, highlight = highlight, category = category}
end

local function removeESP(obj)
    if objectData[obj] then
        objectData[obj].billboard:Destroy()
        objectData[obj].highlight:Destroy()
        objectData[obj] = nil
    end
end

-- === TP LIST UPDATE ===
local function updateTpList()
    if not tpList then return end
    tpList:ClearAllChildren()
    local y = 0
    for obj, data in pairs(objectData) do
        if data.category == "CHEST" then
            local btn = Instance.new("TextButton")
            btn.Size = UDim2.new(1,-5,0,25)
            btn.Position = UDim2.new(0,0,0,y)
            btn.BackgroundColor3 = Color3.fromRGB(50,50,50)
            btn.TextColor3 = Color3.new(1,0.85,0)
            btn.TextScaled = true
            btn.Font = Enum.Font.Gotham
            btn.Text = data.text.Text
            btn.Parent = tpList
            y += 30

            btn.MouseButton1Click:Connect(function()
                local char = player.Character
                if char and char:FindFirstChild("HumanoidRootPart") then
                    local root = char.HumanoidRootPart
                    local mainPart = getMainPart(obj)
                    if mainPart then
                        local tween = TweenService:Create(root, TweenInfo.new(1, Enum.EasingStyle.Quad), {CFrame = CFrame.new(mainPart.Position + Vector3.new(0,5,0))})
                        tween:Play()
                        tpFrame.Visible = false
                    end
                end
            end)
        end
    end
    tpList.CanvasSize = UDim2.new(0,0,0,y)
end

-- === REGISTER ===
local function registerObject(obj)
    local cat = getCategory(obj)
    if not cat then return end
    if objectData[obj] then return end
    createESP(obj, cat)
    updateTpList()
end

local function unregisterObject(obj)
    removeESP(obj)
    updateTpList()
end

-- === INIT ===
for _, o in ipairs(Workspace:GetDescendants()) do registerObject(o) end
table.insert(connections, Workspace.DescendantAdded:Connect(registerObject))
table.insert(connections, Workspace.DescendantRemoving:Connect(unregisterObject))

table.insert(connections, RunService.RenderStepped:Connect(function()
    if not CONFIG.ENABLED then
        for _, d in pairs(objectData) do
            d.billboard.Enabled = false
            d.highlight.Enabled = false
        end
        return
    end

    for obj, data in pairs(objectData) do
        local active = (data.category == "CHEST" and CONFIG.SHOW_CHESTS) or
                       (data.category == "ITEM" and CONFIG.SHOW_ITEMS) or
                       (data.category == "RESOURCE" and CONFIG.SHOW_RESOURCES) or
                       (data.category == "PLAYER" and CONFIG.SHOW_PLAYERS) or
                       (data.category == "NPC" and CONFIG.SHOW_NPCS) or
                       (data.category == "MOB" and CONFIG.SHOW_MOBS)

        if obj and obj.Parent and active then
            local color = getItemColor(obj.Name, data.category)
            data.text.TextColor3 = color
            data.highlight.OutlineColor = color
            data.billboard.Enabled = true
            data.highlight.Enabled = true
        else
            data.billboard.Enabled = false
            data.highlight.Enabled = false
        end
    end
end))

-- === GUI CREATION ===
screenGui = Instance.new("ScreenGui")
screenGui.Name = "ESPDetector"
screenGui.Parent = playerGui

