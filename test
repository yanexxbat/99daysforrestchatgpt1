local function refreshTpList()
    if not tpList or destroyed then return end
    
    local success = pcall(function()
        for _, child in ipairs(tpList:GetChildren()) do
            if child:IsA("GuiObject") then
                child:Destroy()
            end
        end
        
        local yOffset = 0
        local chestCount = 0
        
        for obj, data in pairs(objectData) do
            if data.category == "CHEST" and obj and obj.Parent then
                chestCount = chestCount + 1
                
                local btn = Instance.new("TextButton")
                btn.Size = UDim2.new(1, -8, 0, 35)
                btn.Position = UDim2.new(0, 4, 0, yOffset)
                btn.BackgroundColor3 = COLORS.bgMid
                btn.TextColor3 = COLORS.text
                
                local distance = "Unknown"
                local char = localPlayer.Character
                if char and char:FindFirstChild("HumanoidRootPart") then
                    local mainPart = getMainPart(obj)
                    if mainPart then
                        local dist = (char.HumanoidRootPart.Position - mainPart.Position).Magnitude
                        distance = math.floor(dist) .. "m"
                    end
                end
                
                btn.Text = string.format("%s - %s", data.label and data.label.Text or "Chest", distance)
                btn.Font = Enum.Font.GothamSemibold
                btn.TextScaled = true
                btn.Parent = tpList
                Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 6)

                btn.MouseButton1Click:Connect(function()
                    local character = localPlayer.Character
                    local root = character and character:FindFirstChild("HumanoidRootPart")
                    local targetPart = getMainPart(obj)
                    
                    if root and targetPart then
                        local success = stepTeleport(root, targetPart.Position)
                        if success then
                            tpFrame.Visible = false
                            btn.BackgroundColor3 = COLORS.success
                            btn.Text = "✓ Teleported!"
                            task.wait(0.5)
                            btn.BackgroundColor3 = COLORS.bgMid
                        else
                            btn.BackgroundColor3 = COLORS.danger
                            btn.Text = "✗ Failed!"
                            task.wait(1)
                            btn.BackgroundColor3 = COLORS.bgMid
                        end
                    end
                end)

                yOffset = yOffset + 40
            end
        end
        
        if chestCount == 0 then
            local noChestsLabel = Instance.new("TextLabel")
            noChestsLabel.Size = UDim2.new(1, -8, 0, 30)
            noChestsLabel.Position = UDim2.new(0, 4, 0, 10)
            noChestsLabel.BackgroundTransparency = 1
            noChestsLabel.Text = "No chests found"
            noChestsLabel.TextColor3 = COLORS.textSub
            noChestsLabel.TextScaled = true
            noChestsLabel.Font = Enum.Font.Gotham
            noChestsLabel.Parent = tpList
            yOffset = 50
        end
        
        tpList.CanvasSize = UDim2.new(0, 0, 0, yOffset + 10)
    end)
    
    if not success then
        warn("refreshTpList failed")
    end
end

chestTpBtn.MouseButton1Click:Connect(function()
