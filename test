local function uninject()
    if destroyed then return end
    destroyed = true

    print("Uninject process started...")

    -- Disconnect movement features
    if jumpConnection then
        jumpConnection:Disconnect()
        jumpConnection = nil
    end
    
    -- Reset speed
    local character = localPlayer.Character
    if character then
        local humanoid = character:FindFirstChildOfClass("Humanoid")
        if humanoid then
            humanoid.WalkSpeed = originalWalkSpeed
        end
    end

    for i, connection in ipairs(connections) do
        if typeof(connection) == "RBXScriptConnection" then
            pcall(function() connection:Disconnect() end)
        end
    end
    connections = {}

    local cleanupCount = 0
    for obj, data in pairs(objectData) do
        pcall(function()
            if data.billboard and data.billboard.Parent then 
                data.billboard:Destroy() 
                cleanupCount = cleanupCount + 1
            end
        end)
    end
    
    objectData = {}
    chestIdByObject = setmetatable({}, {__mode="k"})
    campIdByObject = setmetatable({}, {__mode="k"})
    chestCounter, campCounter = 0, 0

    if screenGui and screenGui.Parent then 
        pcall(function() screenGui:Destroy() end)
    end
    
    print("✅ Noctis Utility uninject complete! Cleaned " .. cleanupCount .. " ESP objects.")
    print("✅ Movement features reset!")
end

