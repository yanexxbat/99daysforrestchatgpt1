local function lower(s)
    if not s then return "" end
    local ok, v = pcall(function() return tostring(s):lower() end)
    return ok and v or ""
end

local function colorFor(name, category)
    if category == "CHEST"    then return COLORS.chest end
    if category == "RESOURCE" then return COLORS.resource end
    if category == "NPC"      then return COLORS.npc end
    if category == "MOB"      then return COLORS.mob end
    if category == "PLAYER"   then return COLORS.player end
    if category == "CAMP"     then return COLORS.camp end
    if category == "ITEM"     then return COLORS.item end
    return COLORS.text
end

-- Step teleport function
local function stepTeleport(root, destination)
    if not root or not root.Parent then 
        warn("stepTeleport: Invalid root part")
        return false 
    end
    if not destination or typeof(destination) ~= "Vector3" then 
        warn("stepTeleport: Invalid destination vector")
        return false 
    end
    
    local repeatCount = math.min(CONFIG.STEP_TP_REPEAT, CONSTANTS.MAX_STEP_TP_REPEAT)
    local targetPos = destination + Vector3.new(0, CONFIG.STEP_TP_OFFSET_Y, 0)
    
    for i = 1, repeatCount do
        if not root or not root.Parent then 
            return false 
        end
        
        local success = pcall(function()
            root.CFrame = CFrame.new(targetPos)
            root.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
        end)
        
        if not success then
            return false
        end
        
        task.wait(CONFIG.STEP_TP_DELAY)
    end
    
    return true
end

-- Get main part function
local function getMainPart(obj)
    if not obj or not obj.Parent then return nil end
    
    if obj:IsA("Model") then
        if obj.PrimaryPart and obj.PrimaryPart.Parent then 
            return obj.PrimaryPart 
        end
        
        local commonNames = {"HumanoidRootPart", "Torso", "UpperTorso", "Handle", "Head", "Root"}
        for _, nm in ipairs(commonNames) do
            local p = obj:FindFirstChild(nm)
            if p and p:IsA("BasePart") and p.Parent then 
                return p 
            end
        end
        
        for _, ch in ipairs(obj:GetDescendants()) do
            if ch:IsA("BasePart") and ch.Parent then 
                return ch 
            end
        end
        
        local success, cf = pcall(function() 
            return obj:GetBoundingBox() 
        end)
        
        if success and cf then
            local dummy = Instance.new("Part")
            dummy.Name = "__ESP_TP_Dummy"
            dummy.Anchored = true
            dummy.CanCollide = false
            dummy.Size = Vector3.new(0.1, 0.1, 0.1)
            dummy.CFrame = cf
            dummy.Transparency = 1
            dummy.Parent = Workspace
            
            Debris:AddItem(dummy, CONSTANTS.DUMMY_PART_LIFETIME)
            return dummy
        end
        
    elseif obj:IsA("BasePart") then
        return obj.Parent and obj or nil
    elseif obj:IsA("Humanoid") and obj.Parent then
        return obj.Parent:FindFirstChild("HumanoidRootPart")
    end
    
    return nil
end

local function debouncedCall(key, func, delay)
    delay = delay or 0.1
    if refreshDebounce[key] then return end
    
    refreshDebounce[key] = true
    task.spawn(function()
        task.wait(delay)
        if not destroyed then
            local success = pcall(func)
            if not success then
                warn("Debounced call failed for " .. key)
            end
        end
        refreshDebounce[key] = nil
    end)
end

--=============================
-- FIXED: Better Category Detection
--=============================

local function getCategory(obj)
    if not obj or not obj.Name then return nil end
    
    local n = lower(obj.Name)
    
    -- Players first
    if Players:GetPlayerFromCharacter(obj) then
        return "PLAYER"
    end
    
    -- FIXED: Check flowers FIRST before any other category (including chests)
    for _, keyword in ipairs(SETS.FLOWER) do
        if n:find(keyword) then
            return CONFIG.SHOW_FLOWERS and "RESOURCE" or nil
        end
    end
    
    -- FIXED: Check sticks FIRST before any other category (including chests)
    for _, keyword in ipairs(SETS.STICK) do
        if n:find(keyword) then
            return CONFIG.SHOW_STICKS and "RESOURCE" or nil
        end
    end
    
    -- FIXED: Now check other categories AFTER flowers and sticks are excluded
    for category, keywords in pairs(SETS) do
        -- Skip flower and stick categories as they're already handled above
        if category ~= "FLOWER" and category ~= "STICK" then
            for _, keyword in ipairs(keywords) do
                if n:find(keyword) then
                    return category
                end
            end
        end
    end
    
    -- Tools as items
    if obj:IsA("Tool") or (obj:IsA("Model") and obj:FindFirstChild("Handle")) then
        return "ITEM"
    end
    
    -- Models with humanoid as NPCs
    if obj:IsA("Model") and obj:FindFirstChildOfClass("Humanoid") then
        return "NPC"
    end
    
    return nil
end

