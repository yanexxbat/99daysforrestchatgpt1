local function getCategory(obj)
    if not obj or not obj.Name then return nil end
    local n = safeLower(obj.Name)
    
    -- Player check
    if Players:GetPlayerFromCharacter(obj) then return "PLAYER" end
    
    -- Special categories first
    for _, keyword in ipairs(SETS.FLOWER) do
        if n:find(keyword) then return CONFIG.SHOW_FLOWERS and "RESOURCE" or nil end
    end
    for _, keyword in ipairs(SETS.STICK) do
        if n:find(keyword) then return CONFIG.SHOW_STICKS and "RESOURCE" or nil end
    end
    
    -- Regular categories
    for category, keywords in pairs(SETS) do
        if category ~= "FLOWER" and category ~= "STICK" then
            for _, keyword in ipairs(keywords) do
                if n:find(keyword) then return category end
            end
        end
    end
    
    -- Object type checks
    if obj:IsA("Tool") or (obj:IsA("Model") and obj:FindFirstChild("Handle")) then 
        return "ITEM" 
    end
    if obj:IsA("Model") and obj:FindFirstChildOfClass("Humanoid") then 
        return "NPC" 
    end
    
    return nil
end

local function createESP(obj, category)
    if not obj or not category then return end
    
    pcall(function()
        local mainPart = getMainPart(obj)
        if not mainPart then return end

        local bb = Instance.new("BillboardGui")
        bb.Name = "ESPBillboard"
        bb.Size = UDim2.new(0, 200, 0, 32)
        bb.StudsOffset = Vector3.new(0, 3, 0)
        bb.AlwaysOnTop = true
        bb.MaxDistance = CONFIG.MAX_DISPLAY_DISTANCE
        bb.LightInfluence = 0
        bb.Adornee = mainPart
        bb.Parent = mainPart

        local tl = Instance.new("TextLabel")
        tl.Size = UDim2.new(1, 0, 1, 0)
        tl.BackgroundTransparency = 1
        tl.TextScaled = true
        tl.Font = Enum.Font.GothamSemibold
        tl.TextStrokeTransparency = 0.2
        tl.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)
        tl.TextColor3 = colorFor(obj.Name, category)
        tl.Parent = bb

        local distLabel = Instance.new("TextLabel")
        distLabel.Size = UDim2.new(1, 0, 0.4, 0)
        distLabel.Position = UDim2.new(0, 0, 0.6, 0)
        distLabel.BackgroundTransparency = 1
        distLabel.TextScaled = true
        distLabel.Font = Enum.Font.Gotham
        distLabel.TextStrokeTransparency = 0.2
        distLabel.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)
        distLabel.TextColor3 = Color3.fromRGB(200, 200, 200)
        distLabel.Parent = bb

        local displayText = ""
        if category == "CHEST" then
            if not chestIdByObject[obj] then
                chestCounter = chestCounter + 1
                chestIdByObject[obj] = chestCounter
            end
            displayText = ("Chest #%d"):format(chestIdByObject[obj])
        elseif category == "CAMP" then
            if not campIdByObject[obj] then
                campCounter = campCounter + 1
                campIdByObject[obj] = campCounter
            end
            displayText = ("Camp #%d"):format(campIdByObject[obj])
        elseif category == "PLAYER" then
            local plr = Players:GetPlayerFromCharacter(obj)
            displayText = plr and plr.Name or "Player"
        else
            displayText = obj.Name or "Unknown"
        end
        
        tl.Text = displayText
        objectData[obj] = {
            billboard = bb, 
            label = tl, 
            distLabel = distLabel, 
            category = category, 
            mainPart = mainPart
        }
        
        -- Safe connection setup
        local conn = obj.AncestryChanged:Connect(function()
            if not obj.Parent then
                safeDisconnect(conn)
                if objectData[obj] then
                    pcall(function() 
                        if objectData[obj].billboard then
                            objectData[obj].billboard:Destroy() 
                        end
                    end)
                    objectData[obj] = nil
                end
            end
        end)
        
        print("ESP created for:", obj.Name, "Category:", category)
    end)
end

local function removeESP(obj)
    if not obj then return end
    local data = objectData[obj]
    if data then
        pcall(function() 
            if data.billboard then 
                data.billboard:Destroy() 
            end 
        end)
        objectData[obj] = nil
    end
end

local function registerObject(obj)
    if destroyed or not obj or not obj.Parent or objectData[obj] then return end
    
    pcall(function()
        local category = getCategory(obj)
        if category then 
            createESP(obj, category) 
        end
    end)
end

local function unregisterObject(obj)
    if obj then 
        removeESP(obj) 
    end
end

