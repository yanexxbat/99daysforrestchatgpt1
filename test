-- Category switching function
local function switchCategory(category)
    -- Update button states
    for cat, data in pairs(categoryButtons) do
        local isActive = cat == category
        data.btn.BackgroundColor3 = isActive and COLORS.accent or Color3.fromRGB(0, 0, 0, 0)
        data.icon.TextColor3 = isActive and COLORS.text or COLORS.textSub
        data.text.TextColor3 = isActive and COLORS.text or COLORS.textSub
    end
    
    -- Show/hide content frames
    for cat, frame in pairs(contentFrames) do
        frame.Visible = cat == category
    end
    
    currentCategory = category
end

-- Connect category buttons
for category, data in pairs(categoryButtons) do
    data.btn.MouseButton1Click:Connect(function()
        switchCategory(category)
    end)
end

