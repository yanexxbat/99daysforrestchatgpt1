--=============================
-- Utils / Helpers
--=============================

local function lower(s)
    local ok, v = pcall(function() return s:lower() end)
    return ok and v or ""
end

local function colorFor(name, category)
    local n = lower(name)
    if category == "CHEST"    then return COLORS.chest end
    if category == "RESOURCE" then return COLORS.resource end
    if category == "NPC"      then return COLORS.npc end
    if category == "MOB"      then return COLORS.mob end
    if category == "PLAYER"   then return COLORS.player end
    if category == "CAMP"     then return COLORS.camp end
    if n:find("sword") then return Color3.fromRGB(240,120,120) end
    if n:find("bow")   then return Color3.fromRGB(240,170,100) end
    if n:find("axe")   then return Color3.fromRGB(120,240,120) end
    return COLORS.text
end

-- Step-TP (ehem. AutoFarm-Stil)
local function stepTeleport(root, destination)
    -- Ziel auf Offset in Y anheben, um Bodenkollision zu meiden
    local targetPos = destination + Vector3.new(0, CONFIG.STEP_TP_OFFSET_Y, 0)
    for i = 1, CONFIG.STEP_TP_REPEAT do
        if not root or not root.Parent then return end
        root.CFrame = CFrame.new(targetPos)
        task.wait(CONFIG.STEP_TP_DELAY)
    end
end

-- Robust MainPart ermitteln (mit BoundingBox-Fallback)
local function getMainPart(obj)
    if not obj or not obj.Parent then return nil end
    if obj:IsA("Model") then
        if obj.PrimaryPart then return obj.PrimaryPart end
        for _, nm in ipairs({"HumanoidRootPart","Handle","Torso","Head"}) do
            local p = obj:FindFirstChild(nm)
            if p and p:IsA("BasePart") then return p end
        end
        for _, ch in ipairs(obj:GetDescendants()) do
            if ch:IsA("BasePart") then return ch end
        end
        -- Fallback: BoundingBox
        local cf = CFrame.new()
        local ok, cfOrErr, _ = pcall(function() return obj:GetBoundingBox() end)
        if ok and typeof(cfOrErr) == "CFrame" then
            cf = cfOrErr
        else
            -- Im Zweifel bzgl. Weltursprung
            cf = obj:GetModelCFrame and obj:GetModelCFrame() or CFrame.new()
        end
        local dummy = Instance.new("Part")
        dummy.Name = "__ESP_TP_Anchor"
        dummy.Anchored = true
        dummy.CanCollide = false
        dummy.Size = Vector3.new(1,1,1)
        dummy.CFrame = cf
        dummy.Transparency = 1
        dummy.Parent = Workspace
        Debris:AddItem(dummy, 0.1)
        return dummy
    elseif obj:IsA("BasePart") then
        return obj
    elseif obj:IsA("Humanoid") and obj.Parent then
        return obj.Parent:FindFirstChild("HumanoidRootPart")
    end
    return nil
end

local function isAliveCharacter(model)
    if not model or not model:IsA("Model") then return false end
    local hum = model:FindFirstChildOfClass("Humanoid")
    return hum and hum.Health > 0
end

--=============================
-- Kategorie-Erkennung
--=============================

local function getCategory(obj)
    local n = lower(obj.Name)

    -- Flowers/Blumen -> Resource (optional)
    if n:find("flower") or n:find("blume") then
        return CONFIG.SHOW_FLOWERS and "RESOURCE" or nil
    end
    -- Sticks/Zweige -> Resource (optional)
    if n:find("stick") or n:find("branch") or n:find("ast") then
        return CONFIG.SHOW_STICKS and "RESOURCE" or nil
    end

    -- Camps (Model oder Part)
    for _, key in ipairs(SETS.CAMP) do
        if n:find(key) then return "CAMP" end
    end

    -- Chests: bevorzugt Model
    if obj:IsA("Model") then
        for _, key in ipairs(SETS.CHEST) do
            if n:find(key) then return "CHEST" end
        end
    end

    -- Spieler
    if Players:GetPlayerFromCharacter(obj) then
        return "PLAYER"
    end

    -- Weitere Kategorien
    for cat, list in pairs(SETS) do
        if cat ~= "CHEST" and cat ~= "CAMP" then
            for _, key in ipairs(list) do
                if n:find(key) then
                    if cat == "RESOURCE" then
                        return "RESOURCE"
                    end
                    return cat
                end
            end
        end
    end

    -- Tools/Model mit Handle
    if obj:IsA("Tool") or (obj:IsA("Model") and obj:FindFirstChild("Handle")) then
        return "ITEM"
    end

    return nil
end

--=============================
-- ESP
--=============================

local function createESP(obj, category)
    local mainPart = getMainPart(obj); if not mainPart then return end

    local bb = Instance.new("BillboardGui")
    bb.Name = "ESPBillboard"
    bb.Size = UDim2.new(0, 170, 0, 28)
    bb.StudsOffset = Vector3.new(0, 3, 0)
    bb.AlwaysOnTop = true
    bb.MaxDistance = CONFIG.MAX_DISPLAY_DISTANCE
    bb.Adornee = mainPart
    bb.Parent = mainPart

    local tl = Instance.new("TextLabel")
    tl.Size = UDim2.new(1, 0, 1, 0)
    tl.BackgroundTransparency = 1
    tl.TextScaled = true
    tl.Font = Enum.Font.GothamBold
    tl.TextStrokeTransparency = 0.15
    tl.TextStrokeColor3 = Color3.fromRGB(10,10,10)
    tl.TextColor3 = colorFor(obj.Name, category)
    tl.Parent = bb

    if category == "CHEST" then
        if not chestIdByObject[obj] then
            chestCounter += 1
            chestIdByObject[obj] = chestCounter
        end
        tl.Text = ("Chest %d"):format(chestIdByObject[obj])
    elseif category == "CAMP" then
        if not campIdByObject[obj] then
            campCounter += 1
            campIdByObject[obj] = campCounter
        end
        tl.Text = ("Camp %d"):format(campIdByObject[obj])
    elseif category == "PLAYER" then
        local plr = Players:GetPlayerFromCharacter(obj)
        tl.Text = plr and plr.Name or "Player"
    else
        tl.Text = obj.Name
    end

    objectData[obj] = {billboard = bb, label = tl, category = category}
end

local function removeESP(obj)
    local d = objectData[obj]
    if d then
        if d.billboard then d.billboard:Destroy() end
        objectData[obj] = nil
    end
end

local function isChildOfRegistered(obj)
    local parent = obj.Parent
    while parent do
        if objectData[parent] then return true end
        parent = parent.Parent
    end
    return false
end

local function registerObject(obj)
    if destroyed then return end
    if isChildOfRegistered(obj) then return end
    if objectData[obj] then return end
    local cat = getCategory(obj); if not cat then return end
    createESP(obj, cat)
end

local function unregisterObject(obj)
    removeESP(obj)
end

-- Initial Scan (top-level + eine Ebene)
for _, o in ipairs(Workspace:GetChildren()) do
    registerObject(o)
    for _, m in ipairs(o:GetChildren()) do
        registerObject(m)
    end
end

-- Listener
table.insert(connections, Workspace.DescendantAdded:Connect(function(o)
    task.defer(registerObject, o)
end))
table.insert(connections, Workspace.DescendantRemoving:Connect(unregisterObject))

-- Update Loop (Visibility)
table.insert(connections, RunService.RenderStepped:Connect(function()
    if destroyed then return end
    for obj, data in pairs(objectData) do
        local active =
            CONFIG.ENABLED and obj and obj.Parent and (
                (data.category == "CHEST"    and CONFIG.SHOW_CHESTS)    or
                (data.category == "ITEM"     and CONFIG.SHOW_ITEMS)     or
                (data.category == "RESOURCE" and CONFIG.SHOW_RESOURCES) or
                (data.category == "PLAYER"   and CONFIG.SHOW_PLAYERS)   or
                (data.category == "NPC"      and CONFIG.SHOW_NPCS)      or
                (data.category == "MOB"      and CONFIG.SHOW_MOBS)      or
                (data.category == "CAMP")
            )

        if active then
            if data.billboard then
                data.billboard.Enabled = true
                if data.label then
                    data.label.TextColor3 = colorFor(obj.Name, data.category)
                end
            end
        else
            if data.billboard then
                data.billboard.Enabled = false
            end
        end
    end
end))

