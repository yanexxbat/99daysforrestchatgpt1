-- Toggle Factory
local function createToggle(label, default, onChange)
    local b = Instance.new("TextButton")
    b.Size = UDim2.new(1, -4, 0, 34)
    b.BackgroundColor3 = default and COLORS.ok or COLORS.off
    b.Text = label .. ": " .. (default and "ON" or "OFF")
    b.TextColor3 = COLORS.text
    b.TextScaled = true
    b.Font = Enum.Font.GothamBold
    b.Parent = sectionScroll
    makeRounded(b)

    local state = default
    b.MouseButton1Click:Connect(function()
        state = not state
        b.BackgroundColor3 = state and COLORS.ok or COLORS.off
        b.Text = label .. ": " .. (state and "ON" or "OFF")
        onChange(state)
    end)

    return b
end

