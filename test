table.insert(connections, RunService.Stepped:Connect(function()
    local now = tick()
    
    if tpFrame.Visible and now - lastRefreshTime.chest > CONSTANTS.GUI_REFRESH_INTERVAL then
        debouncedCall("refreshTpList", refreshTpList, 0.1)
        lastRefreshTime.chest = now
    end
    
    if campFrame.Visible and now - lastRefreshTime.camp > CONSTANTS.GUI_REFRESH_INTERVAL then
        debouncedCall("refreshCampList", refreshCampList, 0.1)
        lastRefreshTime.camp = now
    end
end))

