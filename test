local function uninject()
    if destroyed then return end
    destroyed = true

    print("Starting ESP uninject process...")

    -- Connections trennen
    for i, connection in ipairs(connections) do
        if typeof(connection) == "RBXScriptConnection" then
            local success, err = pcall(function() 
                connection:Disconnect() 
            end)
            if not success then
                warn("Failed to disconnect connection " .. i .. ": " .. tostring(err))
            end
        end
    end
    connections = {}

    -- ESP Objects cleanup
    local cleanupCount = 0
    for obj, data in pairs(objectData) do
        local success, err = pcall(function()
            if data.billboard and data.billboard.Parent then 
                data.billboard:Destroy() 
                cleanupCount = cleanupCount + 1
            end
        end)
        if not success then
            warn("Failed to clean ESP for object: " .. tostring(err))
        end
    end
    print("Cleaned up " .. cleanupCount .. " ESP objects")

    -- Reset state
    objectData = {}
    chestIdByObject = setmetatable({}, {__mode="k"})
    campIdByObject = setmetatable({}, {__mode="k"})
    chestCounter, campCounter = 0, 0

    -- GUI cleanup
    if screenGui and screenGui.Parent then 
        local success, err = pcall(function() 
            screenGui:Destroy() 
        end)
        if not success then
            warn("Failed to destroy GUI: " .. tostring(err))
        else
            print("GUI destroyed successfully")
        end
    end
    
    print("✓ ESP/Utility Suite uninject complete!")
end

