-- ESP System
--=============================

local function createESP(obj, category)
    if not obj or not category then return end
    
    local mainPart = getMainPart(obj)
    if not mainPart then return end

    local bb = Instance.new("BillboardGui")
    bb.Name = "ESPBillboard"
    bb.Size = UDim2.new(0, 200, 0, 32)
    bb.StudsOffset = Vector3.new(0, 3, 0)
    bb.AlwaysOnTop = true
    bb.MaxDistance = CONFIG.MAX_DISPLAY_DISTANCE
    bb.LightInfluence = 0
    bb.Adornee = mainPart
    bb.Parent = mainPart

    local tl = Instance.new("TextLabel")
    tl.Size = UDim2.new(1, 0, 1, 0)
    tl.BackgroundTransparency = 1
    tl.TextScaled = true
    tl.Font = Enum.Font.GothamSemibold
    tl.TextStrokeTransparency = 0.2
    tl.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)
    tl.TextColor3 = colorFor(obj.Name, category)
    tl.Parent = bb

    local displayText = ""
    if category == "CHEST" then
        if not chestIdByObject[obj] then
            chestCounter += 1
            chestIdByObject[obj] = chestCounter
        end
        displayText = ("Chest #%d"):format(chestIdByObject[obj])
    elseif category == "CAMP" then
        if not campIdByObject[obj] then
            campCounter += 1
            campIdByObject[obj] = campCounter
        end
        displayText = ("Camp #%d"):format(campIdByObject[obj])
    elseif category == "PLAYER" then
        local plr = Players:GetPlayerFromCharacter(obj)
        displayText = plr and plr.Name or "Player"
    else
        displayText = obj.Name or "Unknown"
    end
    
    tl.Text = displayText
    objectData[obj] = {billboard = bb, label = tl, category = category, mainPart = mainPart}
    
    local connection
    connection = obj.AncestryChanged:Connect(function()
        if not obj.Parent then
            if connection then connection:Disconnect() end
            if objectData[obj] then
                pcall(function() objectData[obj].billboard:Destroy() end)
                objectData[obj] = nil
            end
        end
    end)
end

local function removeESP(obj)
    if not obj then return end
    local data = objectData[obj]
    if data then
        pcall(function() 
            if data.billboard then 
                data.billboard:Destroy() 
            end 
        end)
        objectData[obj] = nil
    end
end

local function registerObject(obj)
    if destroyed or not obj or not obj.Parent then return end
    if objectData[obj] then return end
    
    local category = getCategory(obj)
    if not category then return end
    
    local success = pcall(createESP, obj, category)
    if not success then
        warn("Failed to create ESP for object")
    end
end

local function unregisterObject(obj)
    if not obj then return end
    removeESP(obj)
end

-- Initial registration
task.spawn(function()
    for _, obj in ipairs(Workspace:GetChildren()) do
        registerObject(obj)
        for _, child in ipairs(obj:GetChildren()) do
            registerObject(child)
        end
    end
end)

-- Event listeners
table.insert(connections, Workspace.DescendantAdded:Connect(function(obj)
    task.defer(registerObject, obj)
end))

table.insert(connections, Workspace.DescendantRemoving:Connect(unregisterObject))

-- ESP update loop
local lastESPUpdate = 0
table.insert(connections, RunService.Heartbeat:Connect(function()
    if destroyed then return end
    
    local now = tick()
    if now - lastESPUpdate < CONSTANTS.ESP_UPDATE_INTERVAL then return end
    lastESPUpdate = now
    
    for obj, data in pairs(objectData) do
        if not obj or not obj.Parent then
            task.defer(unregisterObject, obj)
            continue
        end
        
        local cat = data.category
        local shouldShow = CONFIG.ENABLED and (
            (cat == "CHEST"    and CONFIG.SHOW_CHESTS) or
            (cat == "ITEM"     and CONFIG.SHOW_ITEMS) or
            (cat == "RESOURCE" and CONFIG.SHOW_RESOURCES) or
            (cat == "PLAYER"   and CONFIG.SHOW_PLAYERS) or
            (cat == "NPC"      and CONFIG.SHOW_NPCS) or
            (cat == "MOB"      and CONFIG.SHOW_MOBS) or
            (cat == "CAMP"     and CONFIG.SHOW_CAMPS)
        )
        
        local shouldShowName = shouldShow and (
            (cat == "CHEST"    and CONFIG.SHOW_CHEST_NAMES) or
            (cat == "ITEM"     and CONFIG.SHOW_ITEM_NAMES) or
            (cat == "RESOURCE" and CONFIG.SHOW_RESOURCE_NAMES) or
            (cat == "PLAYER"   and CONFIG.SHOW_PLAYER_NAMES) or
            (cat == "NPC"      and CONFIG.SHOW_NPC_NAMES) or
            (cat == "MOB"      and CONFIG.SHOW_MOB_NAMES) or
            (cat == "CAMP"     and CONFIG.SHOW_CAMP_NAMES)
        )
        
        if data.billboard then
            data.billboard.Enabled = shouldShow
            if data.label then
                data.label.Visible = shouldShowName
                if shouldShow then
                    data.label.TextColor3 = colorFor(obj.Name, cat)
                end
            end
        end
    end
end))

