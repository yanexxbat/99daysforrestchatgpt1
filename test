-- Toggle Button Creator
local function createToggle(name, posY, default, callback)
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(0,180,0,25)
    btn.Position = UDim2.new(0,10,0,posY)
    btn.BackgroundColor3 = default and Color3.fromRGB(50,160,70) or Color3.fromRGB(160,50,50)
    btn.Text = name .. ": " .. (default and "ON" or "OFF")
    btn.TextColor3 = Color3.new(1,1,1)
    btn.TextScaled = true
    btn.Font = Enum.Font.Gotham
    btn.Parent = mainFrame

    local state = default
    btn.MouseButton1Click:Connect(function()
        state = not state
        btn.BackgroundColor3 = state and Color3.fromRGB(50,160,70) or Color3.fromRGB(160,50,50)
        btn.Text = name .. ": " .. (state and "ON" or "OFF")
        callback(state)
    end)
end

-- Add Toggles
createToggle("Show Chests", 40, CONFIG.SHOW_CHESTS, function(v) CONFIG.SHOW_CHESTS = v end)
createToggle("Show Items", 70, CONFIG.SHOW_ITEMS, function(v) CONFIG.SHOW_ITEMS = v end)
createToggle("Show Resources", 100, CONFIG.SHOW_RESOURCES, function(v) CONFIG.SHOW_RESOURCES = v end)
createToggle("Show Players", 130, CONFIG.SHOW_PLAYERS, function(v) CONFIG.SHOW_PLAYERS = v end)
createToggle("Show NPCs", 160, CONFIG.SHOW_NPCS, function(v) CONFIG.SHOW_NPCS = v end)
createToggle("Show Mobs", 190, CONFIG.SHOW_MOBS, function(v) CONFIG.SHOW_MOBS = v end)
createToggle("Show Flowers", 220, CONFIG.SHOW_FLOWERS, function(v) CONFIG.SHOW_FLOWERS = v end)
createToggle("Show Sticks", 250, CONFIG.SHOW_STICKS, function(v) CONFIG.SHOW_STICKS = v end)

-- Uninject Button
local uninjectBtn = Instance.new("TextButton")
