-- === ESP Detector Script (Minimal GUI + Clean Intro) ===
-- One ESP per Chest, Flowers/Sticks toggleable
-- Minimal GUI + Chest Teleport + Uninject

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")
local TweenService = game:GetService("TweenService")

local player = Players.LocalPlayer
local playerGui = player:WaitForChild("PlayerGui")

local CONFIG = {
    ENABLED = true,
    SHOW_CHESTS = true,
    SHOW_ITEMS = true,
    SHOW_RESOURCES = true,
    SHOW_PLAYERS = true,
    SHOW_NPCS = true,
    SHOW_MOBS = true,
    SHOW_FLOWERS = true,
    SHOW_STICKS = true,
    MAX_DISPLAY_DISTANCE = 500,
}

local objectData = {}
local chestCounter = 0
local connections = {}
local screenGui

-- === CATEGORY DETECTION ===
local function getCategory(obj)
    local n = obj.Name:lower()
    if (n:find("flower") or n:find("blume")) then
        return CONFIG.SHOW_FLOWERS and "RESOURCE" or nil
    end
    if (n:find("stick") or n:find("ast") or n:find("branch")) then
        return CONFIG.SHOW_STICKS and "RESOURCE" or nil
    end
    if obj:IsA("Model") and (n:find("chest") or n:find("crate") or n:find("loot")) then
        return "CHEST"
    end
    local sets = {
        ITEM = {"axe","sword","bow","key","potion","food","bread","meat","bandage"},
        RESOURCE = {"wood","stone","ore","coal"},
        NPC = {"alien","cultist","npc","villager","soldier","guard"},
        MOB = {"wolf","bear","rat","spider","skeleton","zombie","mob"}
    }
    for cat, list in pairs(sets) do
        for _, v in ipairs(list) do if n:find(v) then return cat end end
    end
    if Players:GetPlayerFromCharacter(obj) then return "PLAYER" end
    return nil
end

-- === MAIN PART DETECTION ===
local function getMainPart(obj)
    if obj:IsA("Model") then
        if obj.PrimaryPart then return obj.PrimaryPart end
        if obj:FindFirstChild("HumanoidRootPart") then return obj.HumanoidRootPart end
        if obj:FindFirstChild("Handle") then return obj.Handle end
        for _, part in ipairs(obj:GetChildren()) do
            if part:IsA("BasePart") then return part end
        end
    elseif obj:IsA("BasePart") then
        return obj
    end
    return nil
end

-- === ESP CREATION ===
local function createESP(obj, category)
    local mainPart = getMainPart(obj)
    if not mainPart then return end

    local billboard = Instance.new("BillboardGui")
    billboard.Size = UDim2.new(0,160,0,25)
    billboard.StudsOffset = Vector3.new(0,3,0)
    billboard.AlwaysOnTop = true
    billboard.MaxDistance = CONFIG.MAX_DISPLAY_DISTANCE
    billboard.Adornee = mainPart
    billboard.Parent = mainPart

    local text = Instance.new("TextLabel")
    text.Size = UDim2.new(1,0,1,0)
    text.BackgroundTransparency = 1
    text.TextScaled = true
    text.Font = Enum.Font.GothamBold
    text.TextColor3 = Color3.new(1,1,1)
    text.Parent = billboard

    if category == "CHEST" then
        chestCounter += 1
        text.Text = "Chest " .. chestCounter
    elseif category == "PLAYER" then
        local plr = Players:GetPlayerFromCharacter(obj)
        text.Text = plr and plr.Name or "Player"
    else
        text.Text = obj.Name
    end

    objectData[obj] = {billboard = billboard, text = text, category = category}
end

local function removeESP(obj)
    if objectData[obj] then
        objectData[obj].billboard:Destroy()
        objectData[obj] = nil
    end
end

local function registerObject(obj)
    local cat = getCategory(obj)
    if not cat then return end
    if objectData[obj] then return end
    createESP(obj, cat)
end

local function unregisterObject(obj)
    removeESP(obj)
end

-- Initial scan
for _, o in ipairs(Workspace:GetDescendants()) do registerObject(o) end
table.insert(connections, Workspace.DescendantAdded:Connect(registerObject))
table.insert(connections, Workspace.DescendantRemoving:Connect(unregisterObject))

-- Update loop
table.insert(connections, RunService.RenderStepped:Connect(function()
    for obj, data in pairs(objectData) do
        if CONFIG.ENABLED and obj and obj.Parent then
            local active = (data.category == "CHEST" and CONFIG.SHOW_CHESTS) or
                           (data.category == "ITEM" and CONFIG.SHOW_ITEMS) or
                           (data.category == "RESOURCE" and CONFIG.SHOW_RESOURCES) or
                           (data.category == "PLAYER" and CONFIG.SHOW_PLAYERS) or
                           (data.category == "NPC" and CONFIG.SHOW_NPCS) or
                           (data.category == "MOB" and CONFIG.SHOW_MOBS)
            data.billboard.Enabled = active
        else
            data.billboard.Enabled = false
        end
    end
end))

