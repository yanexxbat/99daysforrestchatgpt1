local function safeLower(s)
    if not s then return "" end
    local ok, v = pcall(function() return tostring(s):lower() end)
    return ok and v or ""
end

local function colorFor(name, category)
    return COLORS[category:lower()] or Color3.fromRGB(255, 255, 255)
end

local function stepTeleport(root, destination)
    if not root or not root.Parent or not destination then return false end
    print("Teleporting to:", destination)
    pcall(function()
        local targetPos = destination + Vector3.new(0, CONFIG.STEP_TP_OFFSET_Y, 0)
        for i = 1, CONFIG.STEP_TP_REPEAT do
            if not root or not root.Parent then break end
            root.CFrame = CFrame.new(targetPos)
            root.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
            task.wait(CONFIG.STEP_TP_DELAY)
        end
    end)
    return true
end

local function getMainPart(obj)
    if not obj or not obj.Parent then return nil end
    local success, result = pcall(function()
        if obj:IsA("Model") then
            if obj.PrimaryPart and obj.PrimaryPart.Parent then return obj.PrimaryPart end
            local names = {"HumanoidRootPart", "Torso", "UpperTorso", "Handle", "Head", "Root", "Part"}
            for _, name in ipairs(names) do
                local part = obj:FindFirstChild(name)
                if part and part:IsA("BasePart") and part.Parent then return part end
            end
            for _, child in ipairs(obj:GetDescendants()) do
                if child:IsA("BasePart") and child.Parent then return child end
            end
        elseif obj:IsA("BasePart") then
            return obj.Parent and obj or nil
        elseif obj:IsA("Humanoid") and obj.Parent then
            return obj.Parent:FindFirstChild("HumanoidRootPart")
        end
    end)
    return success and result or nil
end

